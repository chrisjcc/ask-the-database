# ==============================================================================
# AskTheDatabase — Environment Configuration Template
# Copy this file to .env and populate your personal / cluster credentials.
# ==============================================================================

# Dynamic Environment & Site Isolation
PYTHONNOUSERSITE=1

# Hugging Face Access Token (for model downloading, tokenizers, and hub uploads)
HF_TOKEN=your_huggingface_token_here

# Hugging Face Cache Directory (Essential for HPC clusters to avoid filling home quota)
# e.g., on DESY Maxwell: HF_HOME=/data/dust/user/<username>/.cache/huggingface
# HF_HOME=/path/to/large/storage/.cache/huggingface

# DVC Remote Storage Configuration (Hugging Face / S3-compatible endpoints)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# Weights & Biases Tracking & Sweeps
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=ask-the-database
WANDB_ENTITY=your_wandb_entity_here
WANDB_REGISTRY_ENTITY=your_wandb_registry_entity_here

# W&B Weave Trajectory Tracing
WEAVE_PROJECT=ask-the-database

# Optional: LLM-as-a-Judge API Keys (for synthetic generation or validation)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
